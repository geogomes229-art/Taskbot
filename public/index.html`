<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#1C1412">
<title>TaskBot - Sala do Futuro</title>
<link rel="preconnect" href="[https://fonts.googleapis.com](https://fonts.googleapis.com)">
<link rel="preconnect" href="[https://fonts.gstatic.com](https://fonts.gstatic.com)" crossorigin>
<link href="[https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200..800&family=Inter:wght@400;500;600&display=swap](https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200..800&family=Inter:wght@400;500;600&display=swap)" rel="stylesheet">
<style>
:root{--bg:#1C1412;--surf:#271E19;--surf2:#322720;--text:#F0EAE2;--text2:#C4B5A3;--text3:#8A7B6B;--acc:#EEDABA;--acc2:#f5dbb5;--ok:#7BAF6E;--err:#D4715E;--border:#3D3229;}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:Inter,sans-serif;background:var(--bg);color:var(--text);min-height:100vh;display:flex;flex-direction:column;font-size:15px}
h1,h2{font-family:'Bricolage Grotesque',sans-serif;font-weight:800}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit}
input{font-family:inherit;font-size:16px;color:var(--text)}
.page{flex:1;display:flex;align-items:center;justify-content:center;padding:2rem 1.25rem}
.content<style>
.log{background:var(--surf);border:1px solid var(--border);border-radius:18px;padding:16px 18px;margin-bottom:14px;display:none}
.log.on{display:block}
.lt{font-size:.68rem;font-weight:600;color:var(--text3);text-transform:uppercase;letter-spacing:.08em;margin-bottom:8px}
.le{max-height:170px;overflow-y:auto;display:flex;flex-direction:column;gap:4px}
.li{font-size:.82rem;color:var(--text2);display:flex;align-items:flex-start;gap:6px;line-height:1.4}
.li .d{width:5px;height:5px;border-radius:50%;background:var(--text3);flex-shrink:0;margin-top:5px}
.li.ok .d{background:var(--ok)}.li.ok{color:var(--ok)}
.li.er .d{background:var(--err)}.li.er{color:var(--err)}
.pw{height:3px;background:var(--border);border-radius:2px;margin-top:10px;overflow:hidden;display:none}
.pw.on{display:block}
.pb{height:100%;background:var(--acc);border-radius:2px;transition:width .3s;width:0%}
.mb{position:fixed;inset:0;background:rgba(20,12,8,.75);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;z-index:1000;padding:1rem;opacity:0;pointer-events:none;transition:opacity .25s}
.mb.on{opacity:1;pointer-events:all}
.mo{background:var(--surf);border:1px solid var(--border);border-radius:18px;padding:26px;width:100%;max-width:520px;max-height:88vh;overflow-y:auto;transform:translateY(22px);transition:transform .25s}
.mb.on .mo{transform:translateY(0)}
.mh{display:flex;justify-content:space-between;align-items:center;margin-bottom:1.2rem;padding-bottom:.875rem;border-bottom:1px solid var(--border)}
.mh h2{font-size:1.2rem}
.mc{font-size:1.1rem;color:var(--text3);padding:.3rem .55rem;border-radius:8px}
.mc:hover{background:var(--surf2);color:var(--text)}
.sar{display:flex;align-items:center;gap:.5rem;padding-bottom:.6rem;margin-bottom:.6rem;border-bottom:1px solid var(--border);cursor:pointer}
.sar label{font-weight:700;font-size:.9rem;cursor:pointer;flex:1}
.al{max-height:260px;overflow-y:auto;display:flex;flex-direction:column;gap:2px;margin-bottom:.75rem}
.ai{display:flex;align-items:center;gap:.5rem;padding:.6rem .75rem;border-radius:8px;border:1px solid transparent;cursor:pointer}
.ai:hover{background:var(--surf2);border-color:var(--border)}
.ai label{flex:1;font-size:.875rem;color:var(--text2);cursor:pointer}
.ai input,.sar input{width:16px;height:16px;accent-color:var(--acc);cursor:pointer;flex-shrink:0}
.ss{min-width:62px;padding:.28rem;background:var(--bg);border:1px solid var(--border);border-radius:8px;color:var(--text);font-size:.76rem;font-family:inherit;cursor:pointer;outline:none}
.badge{display:inline-flex;padding:2px 8px;border-radius:20px;font-size:.7rem;font-weight:600;background:var(--surf2);color:var(--text3);border:1px solid var(--border)}<body>
<main class="page">
<div class="content">
<div class="hero">
<div class="wordmark">TaskBot<span class="bar"></span></div>
<p class="sub">para Sala do Futuro &amp; CMSP</p>
</div>
<div class="card">
<div class="fg">
<label for="ra">RA</label>
<div class="iw">
<input type="text" id="ra" placeholder="RA + dígito + sp" autocomplete="username" spellcheck="false">
</div>
</div>
<div class="fg">
<label for="senha">Senha</label>
<div class="iw">
<input type="password" id="senha" placeholder="••••••••" autocomplete="current-password">
<button class="ib" id="toggleSenha" type="button">
<svg id="eyeO" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
<svg id="eyeC" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
</button>
</div>
</div>
<div class="bg">
<button class="btn bp" id="btnP" onclick="go(false)" type="button">
<span class="sp" id="spP"></span>Atividades Pendentes
</button>
<button class="btn bs" id="btnE" onclick="go(true)" type="button">
<span class="sp" id="spE"></span>Atividades Expiradas
</button>
</div>
</div>
<div class="log" id="logCard">
<div class="lt">Status</div>
<div class="le" id="logEl"></div>
<div class="pw" id="pw"><div class="pb" id="pb"></div></div>
</div>
</div>
</main>
<div class="mb" id="modal">
<div class="mo">
<div class="mh">
<h2 id="mTitle">Atividades</h2>
<button class="mc" onclick="closeModal()" type="button">✕</button>
</div>
<div class="sar" onclick="toggleAll()">
<input type="checkbox" id="selAll" onclick="event.stopPropagation();toggleAll()">
<label>Selecionar todas</label>
<span class="badge" id="cnt">0</span>
</div>
<div class="al" id="aList"></div>
<div class="ma">
<button class="btn bs" onclick="closeModal()" type="button">Cancelar</button>
<button class="btn bp" id="btnEx" onclick="exec()" type="button">
<span class="sp" id="spM"></span>Concluir Selecionadas
</button>
</div>
</div>
</div>
<footer>feito com ❤️ por Geovanna</footer>
