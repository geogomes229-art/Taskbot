export default async function handler(req,res){res.setHeader('Access-Control-Allow-Origin','*');res.setHeader('Access-Control-Allow-Methods','GET,POST,OPTIONS');res.setHeader('Access-Control-Allow-Headers','Content-Type,x-api-key,X-Api-Key,ocp-apim-subscription-key,Accept,Accept-Language');if(req.method==='OPTIONS')return res.status(200).end();const targetUrl=req.query.url;if(!targetUrl)return res.status(400).json({error:'Missing url'});const allowed=['https://edusp-api.ip.tv'];if(!allowed.some(a=>targetUrl.startsWith(a)))return res.status(403).json({error:'URL not allowed'});try{const opts={method:req.method==='GET'?'GET':req.method,headers:{}};['content-type','accept','accept-language','x-api-key','X-Api-Key','ocp-apim-subscription-key'].forEach(h=>{const v=req.headers[h.toLowerCase()];if(v)opts.headers[h]=v});if(req.method!=='GET'&&req.body){opts.body=typeof req.body==='string'?req.body:JSON.stringify(req.body);if(!opts.headers['content-type'])opts.headers['content-type']='application/json'}const r=await fetch(targetUrl,opts);const ct=r.headers.get('content-type')||'application/json';const d=await r.text();res.status(r.status).setHeader('Content-Type',ct).send(d)}catch(err){res.status(500).json({error:err.message})}}
